{
  "name": "@nn-diagram/editor",
  "version": "0.1.0",
  "description": "Visual React editor for nn-diagram files",
  "license": "Apache-2.0",
  "author": "yanexr",
  "homepage": "https://yanexr.github.io/nn-diagram/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanexr/nn-diagram.git",
    "directory": "packages/editor"
  },
  "bugs": "https://github.com/yanexr/nn-diagram/issues",
  "keywords": [
    "diagram",
    "react",
    "editor",
    "nn-diagram"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./loader": "./src/loader.tsx",
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsdown --config-loader native && tailwindcss -i src/styles.css -o dist/styles.css --minify && node ../../scripts/check-css.mjs dist/styles.css",
    "typecheck": "tsc --noEmit",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "dependencies": {
    "@nn-diagram/format": "workspace:^",
    "@nn-diagram/viewer": "workspace:^",
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.58.0",
    "react-resizable-panels": "^4.14.5",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@nn-diagram/ui": "workspace:^",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./loader": {
        "types": "./dist/loader.d.ts",
        "default": "./dist/loader.js"
      },
      "./styles.css": "./dist/styles.css"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ]
}
