{
  "name": "@nn-diagram/viewer",
  "version": "0.1.0",
  "description": "React viewer for nn-diagram files: pan, zoom, hover explanations, walkthrough steps and SVG/PDF/PNG export",
  "license": "Apache-2.0",
  "author": "yanexr",
  "homepage": "https://yanexr.github.io/nn-diagram/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanexr/nn-diagram.git",
    "directory": "packages/viewer"
  },
  "bugs": "https://github.com/yanexr/nn-diagram/issues",
  "keywords": [
    "diagram",
    "react",
    "viewer",
    "svg",
    "export",
    "nn-diagram"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsdown --config-loader native && tailwindcss -i src/styles.css -o dist/styles.css --minify && node ../../scripts/check-css.mjs dist/styles.css",
    "typecheck": "tsc --noEmit",
    "gen": "node scripts/gen-sources.mjs",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "dependencies": {
    "@nn-diagram/format": "workspace:^",
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.58.0",
    "modern-screenshot": "^4.7.0",
    "perfect-freehand": "^1.2.2",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@nn-diagram/ui": "workspace:^",
    "@types/katex": "^0.16.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ]
}
